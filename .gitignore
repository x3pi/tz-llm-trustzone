# Build outputs (regenerate with rebuild.sh) -- these are per-build binaries,
# not source; tracking them would blow up repo size and diff noise.
scripts/kick-the-tires/share_build/
scripts/kick-the-tires/share*/
*.log

# Compiled objects from local builds
tz-llm/**/*.o
tz-llm/**/build-chcore/
tz-llm/**/build-rknpure/
tz-llm/**/build-rknpure-no-chcore/
tz-llm/**/build-rknpure2/
tz-llm/tee_os_kernel/ramdisk-dir/
tz-llm/tee_os_kernel/oh_tee/
tz-llm/tee_os_kernel/oh_tee_bak/
tz-llm/tee_os_kernel/user/system-services/system-servers/procmgr/procmgr

# rkdeveloptool's own runtime log dir (grows every run, not source)
tools/rkdeveloptool/log/

# checkpoints/ IS tracked on purpose (small, curated, essential for "revert to
# last good state") -- do not add a blanket checkpoints/ ignore here. If a
# checkpoint image gets too large for comfortable git history, replace it
# in place (same filename) rather than accumulating many dated copies.
#
# Exception: golden-image/ (3.4GB idbloader-through-vendor recovery backup,
# see DEPLOYED_STATE.md) is far too large for git -- keep it on disk only,
# copy it manually when setting up a new environment.
checkpoints/golden-image/

# Ignore generated images and binaries from build scripts
assets/**/*.img
scripts/kick-the-tires/**/*.img
scripts/kick-the-tires/**/*.so
scripts/kick-the-tires/**/*.so.*
scripts/kick-the-tires/**/*.ko
scripts/kick-the-tires/**/*.bin
scripts/kick-the-tires/**/*.plar
scripts/kick-the-tires/xapian-ta
scripts/kick-the-tires/ca
scripts/kick-the-tires/cma_test
scripts/kick-the-tires/detach_test
scripts/kick-the-tires/gups
scripts/kick-the-tires/matmul
scripts/kick-the-tires/npu

# Ignore our newly generated CA and TA in root checkpoints
checkpoints/xapian-ca
checkpoints/xapian-ta
checkpoints/boot.img
checkpoints/uboot_repacked.img
scripts/kick-the-tires/device_opi5plus_REAL/kernel/configs/orangepi5plus_oh_defconfig
scripts/kick-the-tires/rknpu/ca
scripts/kick-the-tires/rknpu/cma_test
scripts/kick-the-tires/rknpu/detach_test
scripts/kick-the-tires/rknpu/matmul
scripts/kick-the-tires/rknpu/gups
scripts/kick-the-tires/rknpu/mpstat
scripts/kick-the-tires/rknpu/npu
checkpoints/boot.img
tz-llm/tee_os_kernel/libc_shared.so
checkpoints/uboot_repacked.img
tz-llm/xapian-tee/tz-llm-trustzone.code-workspace

# evm-tee build artifacts
tz-llm/evm-tee/build.log
tz-llm/evm-tee/checkpoints/
tz-llm/evm-tee/evm-ca/evm-ca
tz-llm/evm-tee/evm-ta/build/
tz-llm/evm-tee/evm-ta/build_tee/
tools/uart/log.txt
scripts/kick-the-tires/evm-ta
checkpoints/evm-ca
checkpoints/evm-ca
checkpoints/evm-ca
scripts/kick-the-tires/evm-ta
