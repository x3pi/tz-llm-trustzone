# Build outputs (regenerate with rebuild.sh) -- these are per-build binaries,
# not source; tracking them would blow up repo size and diff noise.
scripts/kick-the-tires/share_build/
scripts/kick-the-tires/share*/
*.log

# Compiled objects from local builds
tz-llm/**/*.o
tz-llm/**/build-chcore/
tz-llm/**/build-rknpure/
tz-llm/**/build-rknpure-no-chcore/
tz-llm/**/build-rknpure2/
tz-llm/tee_os_kernel/ramdisk-dir/
tz-llm/tee_os_kernel/oh_tee/
tz-llm/tee_os_kernel/oh_tee_bak/
tz-llm/tee_os_kernel/user/system-services/system-servers/procmgr/procmgr

# rkdeveloptool's own runtime log dir (grows every run, not source)
tools/rkdeveloptool/log/

# checkpoints/ IS tracked on purpose (small, curated, essential for "revert to
# last good state") -- do not add a blanket checkpoints/ ignore here. If a
# checkpoint image gets too large for comfortable git history, replace it
# in place (same filename) rather than accumulating many dated copies.
#
# Exception: golden-image/ (3.4GB idbloader-through-vendor recovery backup,
# see DEPLOYED_STATE.md) is far too large for git -- keep it on disk only,
# copy it manually when setting up a new environment.
checkpoints/golden-image/

# Ignore large image files to prevent GitHub push errors
assets/full-flash/userdata.img
assets/full-flash/system_real.img
assets/full-flash/vendor_real.img

# metanode cpp13 toolchain+deps staging tarball (regenerate via scripts/kick-the-tires/cpp13-metanode-deps/README.md, not committed - 360MB build artifact)
scripts/kick-the-tires/cpp13-metanode-deps/cpp13-metanode-deps.tar.gz

# metanode mvm_ta real chcore build artifacts (regenerate per
# scripts/kick-the-tires/cpp13-metanode-deps/README.md)
scripts/kick-the-tires/cpp13-metanode-deps/cpp11-stage.tar.gz
scripts/kick-the-tires/cpp13-metanode-deps/libtbb.a
scripts/kick-the-tires/cpp13-metanode-deps/libxapian.a
scripts/kick-the-tires/cpp13-metanode-deps/libz.a
scripts/kick-the-tires/cpp13-metanode-deps/mvm_ta_output/
scripts/kick-the-tires/cpp13-metanode-deps/mvm_ta_output_*-old/
scripts/kick-the-tires/cpp13-metanode-deps/tbb_include_tmp/
scripts/kick-the-tires/cpp13-metanode-deps/xapian_include_tmp/
scripts/kick-the-tires/cpp13-metanode-deps/cpp11-stage-extracted/
scripts/kick-the-tires/cpp13-metanode-deps/xapian_zlib_pic_rebuild/
scripts/kick-the-tires/cpp13-metanode-deps/old-noPIC-xapian-zlib-backup/

# Full checkpoints backup archive (831MB, packaged via package_assets.sh) --
# far too large for git, keep on disk only.
checkpoints.7z
tz-llm-untracked-assets.tar.gz
