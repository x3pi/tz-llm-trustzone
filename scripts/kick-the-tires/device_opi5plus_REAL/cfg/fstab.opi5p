# fstab file.
#<src>                                                  <mnt_point> <type>    <mnt_flags and options>                              <fs_mgr_flags>
/dev/block/by-name/system              /usr       ext4     ro,barrier=1  wait,required
/dev/block/by-name/vendor              /vendor        ext4     ro,barrier=1  wait,required
/dev/block/by-name/chip_ckm            /chip_ckm        ext4      ro,barrier=1  wait
/dev/block/by-name/sys-prod              /sys_prod        ext4     ro,barrier=1  wait
/dev/block/by-name/chip-prod              /chip_prod        ext4     ro,barrier=1  wait
/dev/block/platform/fe150000.pcie/by-name/ssd            /data       f2fs     discard,noatime,nosuid,nodev,fscrypt=2:aes-256-cts:aes-256-xts,usrquota  wait,check,fileencryption=software,quota
/dev/block/by-name/misc                /misc none none wait,required
